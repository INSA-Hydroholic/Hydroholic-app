generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                    @id @default(autoincrement())
  email                   String                 @unique
  password_hash           String
  nom                     String
  prenom                  String
  username                String                 @unique
  phone                   String
  age                     Int
  sex                     String
  weight                  Float
  height                  Float
  region                  String
  avatar_url              String
  num_intense_activities  Int
  num_moderate_activities Int
  biography               String                 @db.Text
  daily_goal              Int

  hydrationLogs           HydrationLog[]
  createdChallenges       Challenge[]            @relation("Creator")
  participations          ChallengeParticipant[]

  followers               Relationship[]         @relation("Followee")
  following               Relationship[]         @relation("Follower")
}

model Relationship {
  followerID Int
  followeeID Int
  status     String
  created_at DateTime @default(now())

  follower   User     @relation("Follower", fields: [followerID], references: [id])
  followee   User     @relation("Followee", fields: [followeeID], references: [id])

  @@id([followerID, followeeID])
}

model HydrationLog {
  userID      Int
  measured_at DateTime @default(now())
  weight_value Float

  user        User     @relation(fields: [userID], references: [id])

  @@id([userID, measured_at])
}

model Challenge {
  id           Int                    @id @default(autoincrement())
  creator_id   Int
  created_at   DateTime               @default(now())
  title        String
  description  String                 @db.Text
  start_date   DateTime
  end_date     DateTime
  status       String

  creator      User                   @relation("Creator", fields: [creator_id], references: [id])
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id           Int       @id @default(autoincrement())
  challengeID  Int
  userID       Int
  joined_date  DateTime  @default(now())
  status       String

  challenge    Challenge @relation(fields: [challengeID], references: [id])
  user         User      @relation(fields: [userID], references: [id])
}

model Goal {
  id           Int      @id @default(autoincrement())
  goal_type_id Int
  valeur       Float
  start_date   DateTime
  end_date     DateTime
  status       String
}

model GoalType {
  id           Int      @id @default(autoincrement())
  unite        String
  duree        String
}
